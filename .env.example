# 复制本文件为 .env.local 并填入你的 Supabase 项目密钥。
# 不填则应用使用浏览器本地存储（单机试用）。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 服务端 AI/语音功能共用同一个百炼 Key；不要加 VITE_ 前缀。
QWEN_API_KEY=

# 中文读发音练习仅在 Supabase 云端登录模式可用。
# Serverless 可直接复用上面的 VITE_SUPABASE_*，也可用以下服务端别名覆盖。
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 仅供 Serverless 使用，绝不能添加 VITE_ 前缀或暴露给浏览器。
# 用于调用只授予 service_role 的语音限流 RPC。
SUPABASE_SERVICE_ROLE_KEY=

# 发音评估只接收服务端可验证的 audio/wav：单声道 16 位 PCM、8–48 kHz、
# 250ms–6s。同步 ASR 转写后，固定的 qwen3.5-omni-plus 再直接读取原始音频。
QWEN_PRONUNCIATION_MODEL=qwen-audio-3.0-asr-flash
# TTS 模型固定为 qwen3-tts-flash，以匹配数据库中的全局限流策略。
QWEN_TTS_VOICE=Cherry

# 可选：IP 指纹 HMAC 密钥；留空时复用 QWEN_API_KEY。
PRONUNCIATION_RATE_LIMIT_SECRET=
# 限流、并发、租约及全局模型额度固定在 supabase/schema.sql：
# qwen3.5-omni-plus 为 1 次/秒、60 次/分钟，qwen3-tts-flash 为
# 3 次/秒、180 次/分钟；浏览器和 Serverless 请求均不能覆盖。
# 上游超时会按每个 RPC 返回的实际剩余租约收紧。
PRONUNCIATION_SECURITY_TIMEOUT_MS=5000
PRONUNCIATION_UPSTREAM_TIMEOUT_MS=20000
