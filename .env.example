# 复制本文件为 .env.local 并填入你的 Supabase 项目密钥。
# 不填则应用使用浏览器本地存储（单机试用）。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 服务端 AI/语音功能共用同一个百炼 Key；不要加 VITE_ 前缀。
QWEN_API_KEY=

# 中文读发音练习仅在 Supabase 云端登录模式可用。
# Serverless 可直接复用上面的 VITE_SUPABASE_*，也可用以下服务端别名覆盖。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 发音评估先用同步 ASR 转写；单字再用严格 JSON Schema 做读音判断。
QWEN_PRONUNCIATION_MODEL=qwen-audio-3.0-asr-flash
QWEN_PRONUNCIATION_JUDGE_MODEL=qwen3.8-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry

# 可选：IP 指纹 HMAC 密钥；留空时复用 QWEN_API_KEY。
PRONUNCIATION_RATE_LIMIT_SECRET=
# 可选：分布式限流默认值（每分钟用户/IP 30/90，并发用户/IP 2/6）。
PRONUNCIATION_RATE_LIMIT_PER_MINUTE=30
PRONUNCIATION_IP_RATE_LIMIT_PER_MINUTE=90
PRONUNCIATION_CONCURRENCY_PER_USER=2
PRONUNCIATION_CONCURRENCY_PER_IP=6
PRONUNCIATION_LEASE_SECONDS=30
